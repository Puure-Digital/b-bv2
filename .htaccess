ErrorDocument 404 /404.html

RewriteEngine On

# One address for the site: www goes to the bare domain (matches the canonical tags)
RewriteCond %{HTTP_HOST} ^www\.beamsandbraces\.co\.uk$ [NC]
RewriteRule ^(.*)$ https://beamsandbraces.co.uk/$1 [R=301,L]

# Old site (pre-October 2026) addresses, each sent to its nearest new page so
# existing Google rankings and links carry over. Works with or without the trailing slash.
RewriteRule ^composite-decking-norwich/?$ /trex [R=301,L]
RewriteRule ^trex-products/?$ /trex [R=301,L]
RewriteRule ^fencing-norwich/?$ / [R=301,L]
RewriteRule ^garden-pergolas-norfolk/?$ /work [R=301,L]
RewriteRule ^garden-rooms/?$ /work [R=301,L]
RewriteRule ^insulated-garden-rooms/?$ /work [R=301,L]
RewriteRule ^garden-gyms-norfolk/?$ /work [R=301,L]
RewriteRule ^garden-bar-installation/?$ /work [R=301,L]
RewriteRule ^composite-decking-burnham-market/?$ /trex [R=301,L]
RewriteRule ^composite-decking-cromer-norfolk/?$ /trex [R=301,L]
RewriteRule ^composite-decking-eaton-norwich/?$ /trex [R=301,L]
RewriteRule ^composite-decking-holt-norfolk/?$ /trex [R=301,L]
RewriteRule ^composite-decking-horning-norfolk/?$ /trex [R=301,L]
RewriteRule ^composite-decking-hoveton-norfolk/?$ /trex [R=301,L]
RewriteRule ^composite-decking-southwold/?$ /trex [R=301,L]
RewriteRule ^composite-decking-weybourne-norfolk/?$ /trex [R=301,L]
RewriteRule ^composite-decking-wroxham/?$ /trex [R=301,L]
RewriteRule ^areas-we-cover/?$ /contact [R=301,L]
RewriteRule ^testimonials/?$ /about [R=301,L]
RewriteRule ^gallery/?$ /work [R=301,L]
RewriteRule ^faqs/?$ /trex [R=301,L]
RewriteRule ^blog/composite-vs-timber-decking/?$ /trex [R=301,L]
RewriteRule ^blog/trex-decking-jjh-collaboration/?$ /work [R=301,L]
RewriteRule ^blog/wheelchair-accessible-garden-room/?$ /work [R=301,L]
RewriteRule ^blog/january-is-for-planning/?$ / [R=301,L]
RewriteRule ^blog/winter-garden-upgrades/?$ / [R=301,L]
RewriteRule ^blog/?$ / [R=301,L]

# Any other address ending in a slash (but not a real folder) loses the slash
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Anyone still hitting the old page.html address gets sent to the clean version
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve page.html when /page is requested, without changing the address bar
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# ---------- Performance ----------
# The homepage film is AVIF: make sure it is served as an image
AddType image/avif .avif

# Compress text files on the way out
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml text/xml
</IfModule>

# Let browsers keep images, fonts and video for a year. site.css and site.js carry a
# ?v= number that changes on every edit, so they can be kept for a year too.
# Pages themselves are always checked again so new copy shows straight away.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch ".(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
